KB_DEFAULT_ENVIRONMENT=production
KB_DEFAULT_DEBUG=false
KB_POSTGRES_HOST=postgres
KB_DEFAULT_DATABASE_URL=postgresql+asyncpg://linburgh:linburgh@${KB_POSTGRES_HOST}:5432/knowledge_base

KB_MINIO_HOST=minio
KB_STORAGE_MINIO_ENDPOINT=http://${KB_MINIO_HOST}:9000
KB_STORAGE_MINIO_ACCESS_KEY=linburgh
KB_STORAGE_MINIO_SECRET_KEY=change-me
KB_STORAGE_MINIO_BUCKET=knowledge-base

KB_CHAT_MODEL=change-me
KB_CHAT_API_KEY=change-me
KB_CHAT_BASE_URL=https://api.example.com/v1

KB_RAG_CHUNK_SIZE=600
KB_RAG_CHUNK_OVERLAP=100
KB_RAG_RETRIEVAL_TOP_K=5
KB_RAG_RERANK_ENABLED=true
KB_RAG_RERANK_MODEL=hans-tech/bge-reranker-v2-m3:260522
KB_RAG_RERANK_BASE_URL=http://127.0.0.1:11434
KB_RAG_RERANK_ENDPOINT=/api/rerank
KB_RAG_RERANK_API_KEY=ollama
KB_RAG_RERANK_TIMEOUT_SECONDS=30
KB_RAG_RERANK_FAIL_OPEN=true
KB_RAG_RERANK_CANDIDATE_MULTIPLIER=3
KB_RAG_MAX_CONTEXT_LENGTH=8000

KB_EMBEDDING_MODEL=text-embedding-3-small
KB_EMBEDDING_API_KEY=change-me
KB_EMBEDDING_BASE_URL=https://api.example.com/v1
