default:
  environment: development
  debug: false
  log_dir: ./log
  log_file: app.log
  log_level: INFO
  database_url: postgresql+asyncpg://linburgh:linburgh@127.0.0.1:5432/knowledge_base
  dev_user_id: dev-user
  http_trust_env: false
  request_id_header: X-Request-ID
  db_connect_on_startup: true
  allowed_file_extensions:
    - .pdf
    - .md
    - .markdown
    - .txt
    - .docx
  max_upload_size_mb: 100

rag:
  chunk_size: 600
  chunk_overlap: 100
  retrieval_top_k: 5
  rerank_enabled: false
  max_context_length: 8000

storage:
  backend: minio
  local_dir: ./storage
  minio_endpoint: http://127.0.0.1:9000
  minio_access_key: linburgh
  minio_secret_key: linburgh
  minio_bucket: knowledge-base
  minio_secure: false

model:
  chat_model: change-me
  embedding_model: change-me
  api_key: change-me
  base_url: http://127.0.0.1:8000/v1
  timeout_seconds: 30

security:
  dev_user_id: dev-user
